    "mock: bundle-relative mock/{loader}.js; mock_marketing -> marketing.js"
  ],
  "runtime_contract": "runtimeAllowed(category) from consent-manager; persisted categories_v2 remains separate; unchanged v2 fingerprints/schema 3"
}
